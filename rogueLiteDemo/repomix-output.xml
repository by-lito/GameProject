        if (!Application.CanStreamedLevelBeLoaded(sceneName))
        {
            Debug.LogError("[SceneLoader] La escena '" + sceneName + "' no está añadida al Build Profile o el nombre está mal escrito.");
            return;
        }

        SceneManager.LoadScene(sceneName);
    }
